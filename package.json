{
  "name": "seo-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @seo/web e2e",
    "db:migrate": "pnpm --filter @seo/db db:migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@^8": "^8.5.23",
      "fast-uri@^3": "^3.1.6",
      "fast-uri@^4": "^4.1.3",
      "find-my-way@^9": "^9.7.0",
      "undici@^7": "^7.29.0",
      "nanoid@^3": "^3.3.18",
      "qs@^6": "^6.16.0",
      "hono@^4": "^4.13.5",
      "@ai-sdk/provider-utils@3>undici": "^6.28.0"
    }
  }
}
